<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude hardware-bound Keystore encrypted files from cloud backups -->
        <exclude domain="sharedpref" path="vp_secure_keystore_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vp_secure_keystore_v1.xml" />
    </device-transfer>
</data-extraction-rules>
